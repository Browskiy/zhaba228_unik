@{
    ViewData["Title"] = "Главная";
    var doctor = ViewBag.Doctor as Doctor;
    var today = ViewBag.Today as List<Appointment> ?? new();
    var ru = new System.Globalization.CultureInfo("ru-RU");
    var next = today.FirstOrDefault(a => a.Status == AppointmentStatus.Scheduled && a.StartTime > DateTime.Now);
}

<div class="page-head">
    <div>
        <h1>Приём на сегодня</h1>
        <p>@DateTime.Today.ToString("dddd, d MMMM", ru)@(doctor != null ? $", {doctor.Specialty!.Name.ToLower()}" : "")
            @if (doctor != null)
            {
                <span class="cab ms-2" title="Кабинет">@doctor.Cabinet</span>
            }
        </p>
    </div>
    <a class="btn btn-primary" asp-controller="Appointments" asp-action="DoctorDay">Открыть список пациентов</a>
</div>

@if (doctor == null)
{
    <div class="card-x empty"><i class="bi bi-link-45deg"></i>Учётная запись не привязана к врачу. Обратитесь к администратору.</div>
}
else
{
    <div class="card-x stats mb-4">
        <div class="stat"><div class="label">Пациентов сегодня</div><div class="value">@today.Count</div></div>
        <div class="stat"><div class="label">Принято</div><div class="value">@today.Count(a => a.Status == AppointmentStatus.Completed)</div></div>
        <div class="stat"><div class="label">Следующий</div><div class="value name">@(next != null ? $"{next.StartTime:HH:mm}, {next.Patient!.FullName}" : "Нет")</div></div>
    </div>

    @if (today.Count > 0)
    {
        <div class="card-x">
            <div class="table-responsive">
                <table class="table table-x">
                    <thead><tr><th>Время</th><th>Пациент</th><th>Статус</th></tr></thead>
                    <tbody>
                        @foreach (var a in today)
                        {
                            <tr>
                                <td class="time-cell">@a.StartTime.ToString("HH:mm")</td>
                                <td>@a.Patient!.FullName</td>
                                <td><span class="@a.Status.BadgeClass()">@a.Status.ToRussian()</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
