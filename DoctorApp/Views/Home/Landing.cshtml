@{
    ViewData["Title"] = "Главная";
    var specialties = (List<string>)ViewBag.Specialties;
}

<section class="hero mb-4">
    <i class="bi bi-heart-pulse big-icon"></i>
    <h1>Запись к врачу без очередей и звонков</h1>
    <p class="mb-4">Выберите специалиста, посмотрите свободное время и запишитесь на приём за минуту.
        Сейчас принимают @ViewBag.DoctorCount врачей.</p>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-white btn-lg" asp-controller="Account" asp-action="Register"><i class="bi bi-person-plus"></i> Зарегистрироваться</a>
        <a class="btn btn-ghost-white btn-lg" asp-controller="Account" asp-action="Login">У меня есть аккаунт</a>
    </div>
</section>

<div class="row g-3 how mb-4">
    <div class="col-md-4">
        <div class="card-x card-pad h-100 d-flex gap-3">
            <div class="num">1</div>
            <div><h3 class="h6 mb-1">Выберите врача</h3><p class="text-muted mb-0 small">По специальности или фамилии</p></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-x card-pad h-100 d-flex gap-3">
            <div class="num">2</div>
            <div><h3 class="h6 mb-1">Выберите день и время</h3><p class="text-muted mb-0 small">Видно только свободное время</p></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-x card-pad h-100 d-flex gap-3">
            <div class="num">3</div>
            <div><h3 class="h6 mb-1">Приходите на приём</h3><p class="text-muted mb-0 small">Напомним за сутки</p></div>
        </div>
    </div>
</div>

<div class="card-x card-pad">
    <h2 class="h6 text-muted mb-3">Специальности</h2>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var s in specialties)
        {
            <span class="chip">@s</span>
        }
    </div>
</div>
