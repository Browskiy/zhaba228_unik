@{
    ViewData["Title"] = "Главная";
    var next = ViewBag.Next as Appointment;
}

<div class="page-head">
    <div>
        <h1>Запись и приёмы</h1>
        <p>@User.Identity?.Name</p>
    </div>
    <a class="btn btn-primary" asp-controller="Doctors" asp-action="Index"><i class="bi bi-calendar-plus"></i> Записаться к врачу</a>
</div>

<div class="card-x links mb-4">
    <a class="link-row" asp-controller="Appointments" asp-action="My">
        <i class="bi bi-calendar-check"></i>
        <div><h3>Мои записи</h3><p>Предстоящих: @ViewBag.UpcomingCount, визитов: @ViewBag.VisitCount</p></div>
        <i class="bi bi-chevron-right"></i>
    </a>
    <a class="link-row" asp-controller="Notifications" asp-action="Index">
        <i class="bi bi-bell"></i>
        <div><h3>Уведомления</h3><p>Напоминания и изменения записей</p></div>
        <i class="bi bi-chevron-right"></i>
    </a>
</div>

<div class="card-x">
    <div class="card-head"><h2>Ближайший приём</h2></div>
    @if (next != null)
    {
        <div class="talon-wrap">
            <partial name="_Talon" model="next" />
            <div class="talon-actions"><a class="btn btn-light" asp-controller="Appointments" asp-action="My">Подробнее</a></div>
        </div>
    }
    else
    {
        <div class="empty">Запланированных приёмов нет</div>
    }
</div>
