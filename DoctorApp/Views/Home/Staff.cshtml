@{
    ViewData["Title"] = "Главная";
    var ru = new System.Globalization.CultureInfo("ru-RU");
}

<div class="page-head">
    <div>
        <h1>Регистратура</h1>
        <p>Сегодня @DateTime.Today.ToString("dddd, d MMMM", ru)</p>
    </div>
    <a class="btn btn-primary" asp-controller="Doctors" asp-action="Index"><i class="bi bi-plus-lg"></i> Записать пациента</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="card-x stat"><div class="label"><i class="bi bi-calendar-event"></i> Записей сегодня</div><div class="value">@ViewBag.TodayTotal</div></div></div>
    <div class="col-6 col-lg-3"><div class="card-x stat"><div class="label"><i class="bi bi-clock"></i> Ожидают приёма</div><div class="value" style="color:#0369a1">@ViewBag.TodayScheduled</div></div></div>
    <div class="col-6 col-lg-3"><div class="card-x stat"><div class="label"><i class="bi bi-check2-circle"></i> Проведено</div><div class="value text-success">@ViewBag.TodayCompleted</div></div></div>
    <div class="col-6 col-lg-3"><div class="card-x stat"><div class="label"><i class="bi bi-person-x"></i> Неявки</div><div class="value text-danger">@ViewBag.TodayNoShow</div></div></div>
</div>

<div class="row g-3">
    <div class="col-md-6 col-xl-4">
        <a class="card-x tile primary" asp-controller="Appointments" asp-action="All">
            <div class="tile-icon"><i class="bi bi-journal-medical"></i></div>
            <div><h3>Журнал записей</h3><p>Кто записан на сегодня, отметки о приёме</p></div>
        </a>
    </div>
    <div class="col-md-6 col-xl-4">
        <a class="card-x tile" asp-controller="Doctors" asp-action="Index">
            <div class="tile-icon"><i class="bi bi-person-badge"></i></div>
            <div><h3>Врачи и запись</h3><p>Записать пациента, карточки врачей (@ViewBag.DoctorCount)</p></div>
        </a>
    </div>
    <div class="col-md-6 col-xl-4">
        <a class="card-x tile" asp-controller="Reports" asp-action="Index">
            <div class="tile-icon"><i class="bi bi-bar-chart-line"></i></div>
            <div><h3>Отчёты</h3><p>Загрузка врачей, неявки, выгрузка CSV</p></div>
        </a>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-6 col-xl-4">
            <a class="card-x tile" asp-controller="Users" asp-action="Index">
                <div class="tile-icon"><i class="bi bi-people-fill"></i></div>
                <div><h3>Пользователи</h3><p>Роли и доступ сотрудников</p></div>
            </a>
        </div>
    }
</div>
