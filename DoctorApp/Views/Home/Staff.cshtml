@{
    ViewData["Title"] = "Главная";
    var ru = new System.Globalization.CultureInfo("ru-RU");
}

<div class="page-head">
    <div>
        <h1>Регистратура</h1>
        <p>Сегодня @DateTime.Today.ToString("dddd, d MMMM", ru)</p>
    </div>
    <a class="btn btn-primary" asp-controller="Doctors" asp-action="Index"><i class="bi bi-plus-lg"></i> Записать пациента</a>
</div>

<div class="card-x stats mb-4">
    <div class="stat"><div class="label">Записей сегодня</div><div class="value">@ViewBag.TodayTotal</div></div>
    <div class="stat"><div class="label">Ожидают приёма</div><div class="value">@ViewBag.TodayScheduled</div></div>
    <div class="stat"><div class="label">Проведено</div><div class="value">@ViewBag.TodayCompleted</div></div>
    <div class="stat"><div class="label">Неявки</div><div class="value">@ViewBag.TodayNoShow</div></div>
</div>

<div class="card-x links">
    <a class="link-row" asp-controller="Appointments" asp-action="All">
        <i class="bi bi-journal-medical"></i>
        <div><h3>Журнал записей</h3><p>Кто записан на сегодня, отметки о приёме</p></div>
        <i class="bi bi-chevron-right"></i>
    </a>
    <a class="link-row" asp-controller="Doctors" asp-action="Index">
        <i class="bi bi-person-badge"></i>
        <div><h3>Врачи и запись</h3><p>Записать пациента, карточки врачей (@ViewBag.DoctorCount)</p></div>
        <i class="bi bi-chevron-right"></i>
    </a>
    <a class="link-row" asp-controller="Reports" asp-action="Index">
        <i class="bi bi-bar-chart-line"></i>
        <div><h3>Отчёты</h3><p>Загрузка врачей, неявки, выгрузка CSV</p></div>
        <i class="bi bi-chevron-right"></i>
    </a>
    @if (User.IsInRole("Admin"))
    {
        <a class="link-row" asp-controller="Users" asp-action="Index">
            <i class="bi bi-people"></i>
            <div><h3>Пользователи</h3><p>Роли и доступ сотрудников</p></div>
            <i class="bi bi-chevron-right"></i>
        </a>
    }
</div>
