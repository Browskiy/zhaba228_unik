@{
    ViewData["Title"] = "Главная";
    var next = ViewBag.Next as Appointment;
}

<div class="p-4 p-md-5 mb-4 bg-light rounded-3 border">
    <h1 class="display-6">Запись к врачу без очередей и звонков</h1>
    <p class="lead mb-4">Выберите специалиста, посмотрите свободное время и запишитесь на приём онлайн.
        Сейчас принимают @ViewBag.DoctorCount врачей по @ViewBag.SpecialtyCount специальностям.</p>
    <a class="btn btn-primary btn-lg" asp-controller="Doctors" asp-action="Index">Выбрать врача</a>
    @if (User.Identity?.IsAuthenticated != true)
    {
        <a class="btn btn-outline-primary btn-lg ms-2" asp-controller="Account" asp-action="Register">Зарегистрироваться</a>
    }
</div>

@if (User.IsInRole("Patient"))
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Ближайший приём</h5>
            @if (next != null)
            {
                <p class="card-text mb-2">
                    <strong>@next.StartTime.ToString("dd.MM.yyyy HH:mm")</strong> —
                    @next.Doctor!.Specialty!.Name, @next.Doctor.FullName, кабинет @next.Doctor.Cabinet
                </p>
            }
            else
            {
                <p class="card-text text-muted mb-2">Запланированных приёмов нет.</p>
            }
            <a asp-controller="Appointments" asp-action="My">Все мои записи →</a>
        </div>
    </div>
}

@if (ViewBag.TodayCount != null)
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Сегодня</h5>
            <p class="card-text">Записей на сегодня: <strong>@ViewBag.TodayCount</strong></p>
            @if (User.IsInRole("Doctor"))
            {
                <a asp-controller="Appointments" asp-action="DoctorDay">Список моих пациентов →</a>
            }
            else
            {
                <a asp-controller="Appointments" asp-action="All">Открыть журнал записей →</a>
            }
        </div>
    </div>
}
