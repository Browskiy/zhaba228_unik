@model List<User>
@{
    ViewData["Title"] = "Пользователи";
}

<h2>Пользователи и роли</h2>

<table class="table align-middle">
    <thead class="table-light"><tr><th>ФИО</th><th>Логин</th><th>Телефон</th><th>Зарегистрирован</th><th>Роль</th></tr></thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.FullName</td>
                <td>@u.Login</td>
                <td>@u.Phone</td>
                <td>@u.CreatedAt.ToString("dd.MM.yyyy")</td>
                <td>
                    <form asp-action="SetRole" asp-route-id="@u.Id" method="post" class="d-flex gap-2">
                        <select name="role" class="form-select form-select-sm" style="max-width:180px">
                            @foreach (UserRole r in Enum.GetValues<UserRole>())
                            {
                                <option value="@r" selected="@(r == u.Role)">@r.ToRussian()</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-outline-primary">Сохранить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
