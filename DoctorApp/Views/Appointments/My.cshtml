@model List<Appointment>
@{
    ViewData["Title"] = "Мои записи";
    var ru = new System.Globalization.CultureInfo("ru-RU");
    var upcoming = Model.Where(a => a.Status == AppointmentStatus.Scheduled && a.StartTime > DateTime.Now).OrderBy(a => a.StartTime).ToList();
    var history = Model.Except(upcoming).ToList();
}

<div class="page-head">
    <div>
        <h1>Мои записи</h1>
        <p>Здесь можно перенести или отменить запись</p>
    </div>
    <a class="btn btn-primary" asp-controller="Doctors" asp-action="Index"><i class="bi bi-calendar-plus"></i> Новая запись</a>
</div>

<h2 class="h6 text-muted mb-2">Предстоящие приёмы</h2>
@if (upcoming.Count == 0)
{
    <div class="card-x empty mb-4">
        <i class="bi bi-calendar"></i>Запланированных приёмов нет
        <div class="mt-3"><a class="btn btn-primary" asp-controller="Doctors" asp-action="Index">Записаться к врачу</a></div>
    </div>
}
<div class="d-flex flex-column gap-2 mb-4">
    @foreach (var a in upcoming)
    {
        <div class="card-x card-pad d-flex flex-wrap align-items-center gap-3">
            <div class="date-block">
                <div class="d">@a.StartTime.Day</div>
                <div class="m">@a.StartTime.ToString("MMM", ru)</div>
            </div>
            <div class="flex-grow-1">
                <div class="fw-semibold fs-5">@a.StartTime.ToString("HH:mm") <span class="text-muted fs-6 fw-normal">· @a.StartTime.ToString("dddd", ru)</span></div>
                <div class="text-muted">@a.Doctor!.Specialty!.Name · @a.Doctor.FullName · кабинет @a.Doctor.Cabinet</div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-soft" asp-controller="Doctors" asp-action="Schedule"
                   asp-route-id="@a.DoctorId" asp-route-date="@a.StartTime.ToString("yyyy-MM-dd")" asp-route-rescheduleId="@a.Id"><i class="bi bi-arrow-repeat"></i> Перенести</a>
                <form asp-action="Cancel" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Отменить запись на @a.StartTime.ToString("dd.MM HH:mm")?');">
                    <button class="btn btn-light text-danger"><i class="bi bi-x-lg"></i> Отменить</button>
                </form>
            </div>
        </div>
    }
</div>

<div class="card-x">
    <div class="card-head"><h2>История визитов</h2></div>
    @if (history.Count == 0)
    {
        <div class="empty">Пока пусто</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-x">
                <thead><tr><th>Дата</th><th>Врач</th><th>Статус</th></tr></thead>
                <tbody>
                    @foreach (var a in history)
                    {
                        <tr>
                            <td class="text-nowrap">@a.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@a.Doctor!.FullName <div class="small text-muted">@a.Doctor.Specialty!.Name</div></td>
                            <td><span class="@a.Status.BadgeClass()"><i class="bi @a.Status.Icon()"></i> @a.Status.ToRussian()</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
