@model List<Appointment>
@{
    ViewData["Title"] = "Мои записи";
    var ru = new System.Globalization.CultureInfo("ru-RU");
    var upcoming = Model.Where(a => a.Status == AppointmentStatus.Scheduled && a.StartTime > DateTime.Now).OrderBy(a => a.StartTime).ToList();
    var history = Model.Except(upcoming).ToList();
}

<div class="page-head">
    <div>
        <h1>Мои записи</h1>
        <p>Здесь можно перенести или отменить запись</p>
    </div>
    <a class="btn btn-primary" asp-controller="Doctors" asp-action="Index"><i class="bi bi-calendar-plus"></i> Новая запись</a>
</div>

<div class="card-x mb-4">
    <div class="card-head"><h2>Предстоящие приёмы</h2></div>
    @if (upcoming.Count == 0)
    {
        <div class="empty">Запланированных приёмов нет</div>
    }
    @foreach (var a in upcoming)
    {
        if (a == upcoming[0])
        {
            <div class="talon-wrap">
                <partial name="_Talon" model="a" />
                <div class="talon-actions">
                    <a class="btn btn-light" asp-controller="Doctors" asp-action="Schedule"
                       asp-route-id="@a.DoctorId" asp-route-date="@a.StartTime.ToString("yyyy-MM-dd")" asp-route-rescheduleId="@a.Id">Перенести</a>
                    <form asp-action="Cancel" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Отменить запись на @a.StartTime.ToString("dd.MM HH:mm")?');">
                        <button class="btn btn-quiet danger w-100">Отменить</button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="visit">
                <div class="date-block">
                    <div class="d">@a.StartTime.Day</div>
                    <div class="m">@a.StartTime.ToString("MMM", ru)</div>
                </div>
                <div class="flex-grow-1">
                    <div class="when">@a.StartTime.ToString("HH:mm") <span>@a.StartTime.ToString("dddd", ru)</span></div>
                    <div class="text-muted">@a.Doctor!.Specialty!.Name, @a.Doctor.FullName</div>
                </div>
                <span class="cab" title="Кабинет">@a.Doctor.Cabinet</span>
                <div class="d-flex gap-1">
                    <a class="btn btn-light" asp-controller="Doctors" asp-action="Schedule"
                       asp-route-id="@a.DoctorId" asp-route-date="@a.StartTime.ToString("yyyy-MM-dd")" asp-route-rescheduleId="@a.Id">Перенести</a>
                    <form asp-action="Cancel" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Отменить запись на @a.StartTime.ToString("dd.MM HH:mm")?');">
                        <button class="btn btn-quiet danger w-100">Отменить</button>
                    </form>
                </div>
            </div>
        }
    }
</div>

<div class="card-x">
    <div class="card-head"><h2>История визитов</h2></div>
    @if (history.Count == 0)
    {
        <div class="empty">Пока пусто</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-x">
                <thead><tr><th>Дата</th><th>Врач</th><th>Статус</th></tr></thead>
                <tbody>
                    @foreach (var a in history)
                    {
                        <tr>
                            <td class="text-nowrap">@a.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@a.Doctor!.FullName <div class="small text-muted">@a.Doctor.Specialty!.Name</div></td>
                            <td><span class="@a.Status.BadgeClass()">@a.Status.ToRussian()</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
