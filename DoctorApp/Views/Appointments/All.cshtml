@model List<Appointment>
@{
    ViewData["Title"] = "Журнал записей";
    DateTime date = ViewBag.Date;
    var ru = new System.Globalization.CultureInfo("ru-RU");
    int? doctorId = Context.Request.Query["doctorId"].Count > 0 && int.TryParse(Context.Request.Query["doctorId"], out var did) ? did : null;
}

<div class="page-head">
    <div>
        <h1>Журнал записей</h1>
        <p>Отмечайте, пришёл ли пациент</p>
    </div>
    <a class="btn btn-primary" asp-controller="Doctors" asp-action="Index"><i class="bi bi-plus-lg"></i> Записать пациента</a>
</div>

<form method="get" class="toolbar">
    <a class="btn btn-light btn-icon" aria-label="Предыдущий день" asp-route-date="@date.AddDays(-1).ToString("yyyy-MM-dd")" asp-route-doctorId="@doctorId" title="Предыдущий день"><i class="bi bi-chevron-left"></i></a>
    <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control date-field" aria-label="Дата" onchange="this.form.submit()" />
    <a class="btn btn-light btn-icon" aria-label="Следующий день" asp-route-date="@date.AddDays(1).ToString("yyyy-MM-dd")" asp-route-doctorId="@doctorId" title="Следующий день"><i class="bi bi-chevron-right"></i></a>
    <a class="btn btn-light" asp-route-doctorId="@doctorId">Сегодня</a>
    <span class="day-name">@date.ToString("dddd, d MMMM", ru)</span>
    <select name="doctorId" class="form-select" style="max-width:280px" asp-items="ViewBag.Doctors" onchange="this.form.submit()">
        <option value="">Все врачи</option>
    </select>
</form>

<div class="status-sum">
    @foreach (AppointmentStatus st in Enum.GetValues<AppointmentStatus>())
    {
        <span class="@st.BadgeClass()">@st.ToRussian(): @Model.Count(a => a.Status == st)</span>
    }
</div>

<div class="card-x">
    @if (Model.Count == 0)
    {
        <div class="empty"><i class="bi bi-journal"></i>На этот день записей нет</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-x">
                <thead><tr><th>Время</th><th>Пациент</th><th>Врач</th><th>Кабинет</th><th>Статус</th><th class="text-end">Действия</th></tr></thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr class="@(a.Status == AppointmentStatus.Cancelled ? "cancelled" : "")">
                            <td class="time-cell">@a.StartTime.ToString("HH:mm")</td>
                            <td>
                                <div class="fw-medium">@a.Patient!.FullName</div>
                                <div class="small text-muted">@a.Patient.Phone</div>
                            </td>
                            <td>@a.Doctor!.FullName <div class="small text-muted">@a.Doctor.Specialty!.Name</div></td>
                            <td><span class="cab">@a.Doctor.Cabinet</span></td>
                            <td><span class="@a.Status.BadgeClass()">@a.Status.ToRussian()</span></td>
                            <td class="text-end">
                                <div class="row-actions">
                                <partial name="_StatusActions" model="a" />
                                @if (a.Status == AppointmentStatus.Scheduled)
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-quiet btn-icon" data-bs-toggle="dropdown" title="Ещё" aria-label="Ещё"><i class="bi bi-three-dots"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end glass">
                                            <li><a class="dropdown-item" asp-action="Ticket" asp-route-id="@a.Id"><i class="bi bi-ticket-perforated"></i> Талон</a></li>
                                            <li><a class="dropdown-item" asp-controller="Doctors" asp-action="Schedule" asp-route-id="@a.DoctorId" asp-route-date="@a.StartTime.ToString("yyyy-MM-dd")" asp-route-rescheduleId="@a.Id"><i class="bi bi-arrow-repeat"></i> Перенести</a></li>
                                            <li>
                                                <form asp-action="Cancel" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Отменить запись?');">
                                                    <button class="dropdown-item text-danger"><i class="bi bi-x-lg"></i> Отменить запись</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
