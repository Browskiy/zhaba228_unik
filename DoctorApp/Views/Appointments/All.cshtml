@model List<Appointment>
@{
    ViewData["Title"] = "Журнал записей";
    DateTime date = ViewBag.Date;
    var ru = new System.Globalization.CultureInfo("ru-RU");
    int? doctorId = Context.Request.Query["doctorId"].Count > 0 && int.TryParse(Context.Request.Query["doctorId"], out var did) ? did : null;
}

<div class="page-head">
    <div>
        <h1>Журнал записей</h1>
        <p>Отмечайте, пришёл ли пациент. Для новой записи нажмите «Записать пациента».</p>
    </div>
    <a class="btn btn-primary" asp-controller="Doctors" asp-action="Index"><i class="bi bi-plus-lg"></i> Записать пациента</a>
</div>

<div class="card-x mb-3">
    <form method="get" class="card-pad d-flex flex-wrap align-items-center gap-2">
        <a class="btn btn-light" asp-route-date="@date.AddDays(-1).ToString("yyyy-MM-dd")" asp-route-doctorId="@doctorId" title="Предыдущий день"><i class="bi bi-chevron-left"></i></a>
        <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control" style="max-width:170px" onchange="this.form.submit()" />
        <a class="btn btn-light" asp-route-date="@date.AddDays(1).ToString("yyyy-MM-dd")" asp-route-doctorId="@doctorId" title="Следующий день"><i class="bi bi-chevron-right"></i></a>
        <a class="btn btn-light" asp-route-doctorId="@doctorId">Сегодня</a>
        <span class="fw-semibold ms-2 me-auto">@date.ToString("dddd, d MMMM", ru)</span>
        <select name="doctorId" class="form-select" style="max-width:280px" asp-items="ViewBag.Doctors" onchange="this.form.submit()">
            <option value="">Все врачи</option>
        </select>
    </form>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    @foreach (AppointmentStatus st in Enum.GetValues<AppointmentStatus>())
    {
        <span class="@st.BadgeClass()"><i class="bi @st.Icon()"></i> @st.ToRussian(): @Model.Count(a => a.Status == st)</span>
    }
</div>

<div class="card-x">
    @if (Model.Count == 0)
    {
        <div class="empty"><i class="bi bi-journal"></i>На этот день записей нет</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-x">
                <thead><tr><th>Время</th><th>Пациент</th><th>Врач</th><th>Статус</th><th class="text-end">Действия</th></tr></thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr class="@(a.Status == AppointmentStatus.Cancelled ? "text-muted" : "")">
                            <td class="time-cell">@a.StartTime.ToString("HH:mm")</td>
                            <td>
                                <div class="fw-semibold">@a.Patient!.FullName</div>
                                <div class="small text-muted"><i class="bi bi-telephone"></i> @a.Patient.Phone</div>
                            </td>
                            <td>@a.Doctor!.FullName <div class="small text-muted">@a.Doctor.Specialty!.Name · каб. @a.Doctor.Cabinet</div></td>
                            <td><span class="@a.Status.BadgeClass()"><i class="bi @a.Status.Icon()"></i> @a.Status.ToRussian()</span></td>
                            <td class="text-end text-nowrap">
                                <partial name="_StatusActions" model="a" />
                                @if (a.Status == AppointmentStatus.Scheduled)
                                {
                                    <div class="dropdown d-inline">
                                        <button class="btn btn-sm btn-light" data-bs-toggle="dropdown" title="Ещё"><i class="bi bi-three-dots"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" asp-controller="Doctors" asp-action="Schedule" asp-route-id="@a.DoctorId" asp-route-date="@a.StartTime.ToString("yyyy-MM-dd")" asp-route-rescheduleId="@a.Id"><i class="bi bi-arrow-repeat"></i> Перенести</a></li>
                                            <li>
                                                <form asp-action="Cancel" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Отменить запись?');">
                                                    <button class="dropdown-item text-danger"><i class="bi bi-x-lg"></i> Отменить запись</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
