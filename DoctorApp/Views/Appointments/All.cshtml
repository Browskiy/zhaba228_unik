@model List<Appointment>
@{
    ViewData["Title"] = "Журнал записей";
    DateTime date = ViewBag.Date;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Журнал записей</h2>
    <a class="btn btn-success" asp-controller="Doctors" asp-action="Index">+ Записать пациента</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-5">
        <select name="doctorId" class="form-select" asp-items="ViewBag.Doctors">
            <option value="">Все врачи</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100">Показать</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr><th>Время</th><th>Врач</th><th>Пациент</th><th>Телефон</th><th>Статус</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td class="fw-semibold">@a.StartTime.ToString("HH:mm")</td>
                <td>@a.Doctor!.FullName <div class="small text-muted">@a.Doctor.Specialty!.Name, каб. @a.Doctor.Cabinet</div></td>
                <td>@a.Patient!.FullName</td>
                <td>@a.Patient.Phone</td>
                <td><span class="badge @a.Status.BadgeClass()">@a.Status.ToRussian()</span></td>
                <td class="text-end text-nowrap">
                    <partial name="_StatusActions" model="a" />
                    @if (a.Status == AppointmentStatus.Scheduled)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Doctors" asp-action="Schedule"
                           asp-route-id="@a.DoctorId" asp-route-date="@a.StartTime.ToString("yyyy-MM-dd")" asp-route-rescheduleId="@a.Id">Перенести</a>
                        <form asp-action="Cancel" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('Отменить запись?');">
                            <button class="btn btn-sm btn-outline-secondary">Отменить</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted">На эту дату записей нет</td></tr>
        }
    </tbody>
</table>
