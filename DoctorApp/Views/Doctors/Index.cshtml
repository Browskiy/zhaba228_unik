@model List<Doctor>
@{
    bool staff = User.IsInRole("Admin") || User.IsInRole("Registrar");
    bool patient = User.IsInRole("Patient");
    ViewData["Title"] = patient ? "Запись к врачу" : "Врачи";
    var specialties = (List<Specialty>)ViewBag.SpecialtyList;
    int? current = ViewBag.SpecialtyId;
    var nearest = (Dictionary<int, DateTime>)ViewBag.Nearest;
}

@if (patient)
{
    <div class="steps">
        <div class="step current"><span class="n">1</span> Выберите врача</div>
        <span class="step-sep"><i class="bi bi-chevron-right"></i></span>
        <div class="step"><span class="n">2</span> День и время</div>
        <span class="step-sep"><i class="bi bi-chevron-right"></i></span>
        <div class="step"><span class="n">3</span> Подтверждение</div>
    </div>
}

<div class="page-head">
    <div>
        <h1>@(patient ? "К какому врачу записаться?" : "Врачи")</h1>
        <p>@(staff ? "Чтобы записать пациента, нажмите «Записать» у нужного врача" : "Выберите специальность или найдите врача по фамилии")</p>
    </div>
    @if (staff)
    {
        <a class="btn btn-light" asp-action="Create"><i class="bi bi-plus-lg"></i> Добавить врача</a>
    }
</div>

<form method="get" class="mb-4">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="chip @(current == null ? "active" : "")" asp-route-search="@ViewBag.Search">Все</a>
        @foreach (var s in specialties)
        {
            <a class="chip @(current == s.Id ? "active" : "")" asp-route-specialtyId="@s.Id" asp-route-search="@ViewBag.Search">@s.Name</a>
        }
    </div>
    @if (current != null)
    {
        <input type="hidden" name="specialtyId" value="@current" />
    }
    <div class="search">
        <div class="field"><i class="bi bi-search"></i><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Поиск по фамилии" aria-label="Поиск по фамилии" /></div>
        <button class="btn btn-light">Найти</button>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="card-x empty">Врачи не найдены</div>
}

@if (Model.Count > 0)
{
    <div class="card-x">
        @foreach (var d in Model)
        {
            <div class="doc-row @(d.IsActive ? "" : "off")">
                <span class="cab" title="Кабинет">@d.Cabinet</span>
                <div>
                    <div class="fw-medium">@d.FullName</div>
                    <div class="spec">@d.Specialty!.Name, @d.WorkStart.ToString("HH:mm")–@d.WorkEnd.ToString("HH:mm"), приём @d.SlotMinutes мин</div>
                </div>
                <div class="doc-next">
                    @if (!d.IsActive)
                    {
                        <span class="none">Не ведёт приём</span>
                    }
                    else if (nearest.TryGetValue(d.Id, out var slot))
                    {
                        <span class="label">Ближайшее время</span>
                        <a asp-action="Schedule" asp-route-id="@d.Id" asp-route-date="@slot.ToString("yyyy-MM-dd")" asp-route-time="@slot.ToString("HH:mm")">@slot.DayLabel(), @slot.ToString("HH:mm")</a>
                    }
                    else
                    {
                        <span class="label">Ближайшее время</span>
                        <span class="none">Нет на 3 недели</span>
                    }
                </div>
                <div class="doc-actions">
                    @if (d.IsActive)
                    {
                        <a class="btn btn-light" asp-action="Schedule" asp-route-id="@d.Id">@(patient ? "Записаться" : staff ? "Записать" : "Расписание")</a>
                    }
                    @if (staff)
                    {
                        <a class="btn btn-quiet btn-icon" asp-action="Edit" asp-route-id="@d.Id" title="Изменить" aria-label="Изменить"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@d.Id" method="post" onsubmit="return confirm('Удалить врача @d.FullName?');">
                            <button class="btn btn-quiet danger btn-icon" title="Удалить" aria-label="Удалить"><i class="bi bi-trash"></i></button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}
