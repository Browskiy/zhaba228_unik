@model List<Doctor>
@{
    bool staff = User.IsInRole("Admin") || User.IsInRole("Registrar");
    bool patient = User.IsInRole("Patient");
    ViewData["Title"] = patient ? "Запись к врачу" : "Врачи";
    var specialties = (List<Specialty>)ViewBag.SpecialtyList;
    int? current = ViewBag.SpecialtyId;
}

@if (patient)
{
    <div class="steps">
        <div class="step current"><span class="n">1</span> Выберите врача</div>
        <span class="step-sep"><i class="bi bi-chevron-right"></i></span>
        <div class="step"><span class="n">2</span> День и время</div>
        <span class="step-sep"><i class="bi bi-chevron-right"></i></span>
        <div class="step"><span class="n">3</span> Подтверждение</div>
    </div>
}

<div class="page-head">
    <div>
        <h1>@(patient ? "К какому врачу записаться?" : "Врачи")</h1>
        <p>@(staff ? "Чтобы записать пациента, нажмите «Записать» у нужного врача" : "Выберите специальность или найдите врача по фамилии")</p>
    </div>
    @if (staff)
    {
        <a class="btn btn-light" asp-action="Create"><i class="bi bi-plus-lg"></i> Добавить врача</a>
    }
</div>

<form method="get" class="mb-3">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="chip @(current == null ? "active" : "")" asp-route-search="@ViewBag.Search">Все</a>
        @foreach (var s in specialties)
        {
            <a class="chip @(current == s.Id ? "active" : "")" asp-route-specialtyId="@s.Id" asp-route-search="@ViewBag.Search">@s.Name</a>
        }
    </div>
    @if (current != null)
    {
        <input type="hidden" name="specialtyId" value="@current" />
    }
    <div class="input-group" style="max-width:420px">
        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Поиск по фамилии" />
        <button class="btn btn-primary">Найти</button>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="card-x empty"><i class="bi bi-person-x"></i>Врачи не найдены</div>
}

<div class="row g-3">
    @foreach (var d in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card-x doctor-card @(d.IsActive ? "" : "opacity-50")">
                <div class="d-flex gap-3 align-items-center">
                    <div class="avatar @d.FullName.AvatarClass()">@d.FullName.Initials()</div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold">@d.FullName</div>
                        <span class="pill spec">@d.Specialty!.Name</span>
                        @if (!d.IsActive)
                        {
                            <span class="pill st-2">не ведёт приём</span>
                        }
                    </div>
                </div>
                <div class="meta">
                    <span><i class="bi bi-door-open"></i> Кабинет @d.Cabinet</span>
                    <span><i class="bi bi-clock"></i> @d.WorkStart.ToString("HH:mm")–@d.WorkEnd.ToString("HH:mm"), приём @d.SlotMinutes мин</span>
                </div>
                <div class="d-flex gap-2 mt-auto">
                    @if (d.IsActive)
                    {
                        <a class="btn btn-primary flex-grow-1" asp-action="Schedule" asp-route-id="@d.Id">
                            @(patient ? "Записаться" : staff ? "Записать" : "Расписание")
                        </a>
                    }
                    @if (staff)
                    {
                        <a class="btn btn-light" asp-action="Edit" asp-route-id="@d.Id" title="Изменить"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@d.Id" method="post" onsubmit="return confirm('Удалить врача @d.FullName?');">
                            <button class="btn btn-light text-danger" title="Удалить"><i class="bi bi-trash"></i></button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>
