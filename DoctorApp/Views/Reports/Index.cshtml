@model ReportViewModel
@{
    ViewData["Title"] = "Отчёты";
    int max = Model.ByDay.Count == 0 ? 1 : Model.ByDay.Max(d => d.Count);
    var ru = new System.Globalization.CultureInfo("ru-RU");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="page-head">
    <div>
        <h1>Отчёты</h1>
        <p>Записи за период @Model.From.ToString("dd.MM.yyyy") — @Model.To.ToString("dd.MM.yyyy")</p>
    </div>
    <a class="btn btn-light" asp-action="Csv" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"><i class="bi bi-download"></i> Скачать CSV</a>
</div>

<div class="card-x mb-3">
    <form method="get" class="card-pad d-flex flex-wrap align-items-end gap-2">
        <div><label class="form-label">С</label><input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div><label class="form-label">По</label><input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <button class="btn btn-primary"><i class="bi bi-arrow-clockwise"></i> Сформировать</button>
    </form>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="card-x stat"><div class="label"><i class="bi bi-calendar-event"></i> Всего записей</div><div class="value">@Model.Total.Total</div></div></div>
    <div class="col-6 col-lg-3"><div class="card-x stat"><div class="label"><i class="bi bi-check2-circle"></i> Проведено</div><div class="value text-success">@Model.Total.Completed</div></div></div>
    <div class="col-6 col-lg-3"><div class="card-x stat"><div class="label"><i class="bi bi-x-circle"></i> Отменено</div><div class="value text-secondary">@Model.Total.Cancelled</div></div></div>
    <div class="col-6 col-lg-3"><div class="card-x stat"><div class="label"><i class="bi bi-person-x"></i> Неявки</div><div class="value text-danger">@Model.Total.NoShow</div></div></div>
</div>

<div class="card-x mb-3">
    <div class="card-head"><h2>По врачам</h2></div>
            <div class="table-responsive">
                <table class="table table-x">
                    <thead><tr><th>Врач</th><th>Всего</th><th>Ожидают</th><th>Проведено</th><th>Отмен.</th><th>Неявки</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.ByDoctor)
                        {
                            <tr><td class="fw-semibold">@r.Name</td><td>@r.Total</td><td>@r.Scheduled</td><td>@r.Completed</td><td>@r.Cancelled</td><td>@r.NoShow</td></tr>
                        }
                    </tbody>
                </table>
            </div>
</div>

<div class="row g-3">
    <div class="col-xl-7">
        <div class="card-x">
            <div class="card-head"><h2>По специальностям</h2></div>
            <div class="table-responsive">
                <table class="table table-x">
                    <thead><tr><th>Специальность</th><th>Всего</th><th>Проведено</th><th>Неявки</th><th>Доля неявок</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.BySpecialty)
                        {
                            int done = r.Completed + r.NoShow;
                            <tr><td class="fw-semibold">@r.Name</td><td>@r.Total</td><td>@r.Completed</td><td>@r.NoShow</td><td>@(done == 0 ? "—" : $"{100.0 * r.NoShow / done:0}%")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="card-x">
            <div class="card-head"><h2>Загрузка по дням</h2><span class="small text-muted">без отменённых</span></div>
            <div class="card-pad">
                @foreach (var d in Model.ByDay)
                {
                    <div class="bar-row">
                        <div class="lbl">@d.Day.ToString("dd.MM ddd", ru)</div>
                        <div class="flex-grow-1"><div class="bar" style="width:@((100.0 * d.Count / max).ToString("0.#", inv))%"></div></div>
                        <div style="width:28px" class="text-end fw-semibold">@d.Count</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
