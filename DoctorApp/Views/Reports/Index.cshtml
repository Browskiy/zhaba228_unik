@model ReportViewModel
@{
    ViewData["Title"] = "Отчёты";
    int max = Model.ByDay.Count == 0 ? 1 : Model.ByDay.Max(d => d.Count);
    (DateTime Day, int Count)? peak = Model.ByDay.Count == 0 ? null : Model.ByDay.MaxBy(d => d.Count);
    var ru = new System.Globalization.CultureInfo("ru-RU");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="page-head">
    <div>
        <h1>Отчёты</h1>
        <p>Записи за период @Model.From.ToString("dd.MM.yyyy")–@Model.To.ToString("dd.MM.yyyy")</p>
    </div>
    <a class="btn btn-light" asp-action="Csv" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"><i class="bi bi-download"></i> Скачать CSV</a>
</div>

<form method="get" class="toolbar bottom">
        <div><label class="form-label">С</label><input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div><label class="form-label">По</label><input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <button class="btn btn-primary">Сформировать</button>
</form>

<div class="card-x stats mb-4">
    <div class="stat"><div class="label">Всего записей</div><div class="value">@Model.Total.Total</div></div>
    <div class="stat"><div class="label">Проведено</div><div class="value">@Model.Total.Completed</div></div>
    <div class="stat"><div class="label">Отменено</div><div class="value">@Model.Total.Cancelled</div></div>
    <div class="stat"><div class="label">Неявки</div><div class="value">@Model.Total.NoShow</div></div>
</div>

<div class="card-x mb-4">
    <div class="card-head"><h2>По врачам</h2></div>
            <div class="table-responsive">
                <table class="table table-x">
                    <thead><tr><th>Врач</th><th class="num">Всего</th><th class="num">Ожидают</th><th class="num">Проведено</th><th class="num">Отменено</th><th class="num">Неявки</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.ByDoctor)
                        {
                            <tr><td class="fw-medium">@r.Name</td><td class="num">@r.Total</td><td class="num">@r.Scheduled</td><td class="num">@r.Completed</td><td class="num">@r.Cancelled</td><td class="num">@r.NoShow</td></tr>
                        }
                    </tbody>
                </table>
            </div>
</div>

<div class="card-x mb-4">
    <div class="card-head"><h2>По специальностям</h2></div>
    <div class="table-responsive">
        <table class="table table-x">
            <thead><tr><th>Специальность</th><th class="num">Всего</th><th class="num">Проведено</th><th class="num">Неявки</th><th class="num">Доля неявок</th></tr></thead>
            <tbody>
                @foreach (var r in Model.BySpecialty)
                {
                    int done = r.Completed + r.NoShow;
                    <tr><td class="fw-medium">@r.Name</td><td class="num">@r.Total</td><td class="num">@r.Completed</td><td class="num">@r.NoShow</td><td class="num">@(done == 0 ? "–" : $"{100.0 * r.NoShow / done:0}%")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card-x">
    <div class="card-head">
        <h2>Загрузка по дням</h2>
        <span class="small text-muted">@(peak == null ? "Без отменённых" : $"Больше всего {peak.Value.Day.ToString("d MMMM", ru)}, без отменённых")</span>
    </div>
    @if (Model.ByDay.Count == 0)
    {
        <div class="empty">За этот период записей нет</div>
    }
    else
    {
        <div class="chart">
            <div class="chart-cols">
                @foreach (var d in Model.ByDay)
                {
                    <div class="chart-col @(d.Day == peak!.Value.Day ? "peak" : "")" title="@d.Day.ToString("dddd, d MMMM", ru): @d.Count">
                        <div class="v">@d.Count</div>
                        <div class="bar" style="height:@((200.0 * d.Count / max).ToString("0", inv))px"></div>
                    </div>
                }
            </div>
            <div class="chart-days">
                @foreach (var d in Model.ByDay)
                {
                    <div>@d.Day.ToString("dd.MM")<br />@d.Day.ToString("ddd", ru)</div>
                }
            </div>
        </div>
    }
</div>
