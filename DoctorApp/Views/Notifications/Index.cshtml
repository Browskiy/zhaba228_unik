@model List<Notification>
@{
    ViewData["Title"] = "Уведомления";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Уведомления</h2>
    @if (Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllRead" method="post">
            <button class="btn btn-outline-secondary btn-sm">Отметить все как прочитанные</button>
        </form>
    }
</div>

<div class="list-group">
    @foreach (var n in Model)
    {
        <div class="list-group-item @(n.IsRead ? "" : "list-group-item-warning")">
            <div class="d-flex justify-content-between">
                <span>@n.Text</span>
                <small class="text-muted text-nowrap ms-3">@n.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
            </div>
        </div>
    }
    @if (Model.Count == 0)
    {
        <div class="text-muted">Уведомлений нет</div>
    }
</div>
