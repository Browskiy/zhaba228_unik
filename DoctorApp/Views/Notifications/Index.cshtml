@model List<Notification>
@{
    ViewData["Title"] = "Уведомления";
    string Icon(string text) => text.StartsWith("Напоминание") ? "bi-alarm" : text.Contains("отменена") ? "bi-x-circle" : text.Contains("перенесена") ? "bi-arrow-repeat" : text.Contains("неявка") ? "bi-person-x" : text.StartsWith("Вы записаны") ? "bi-calendar-check" : "bi-bell";
}

<div class="page-head">
    <div>
        <h1>Уведомления</h1>
        <p>Записи, переносы, отмены и напоминания о приёме</p>
    </div>
    @if (Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllRead" method="post">
            <button class="btn btn-light"><i class="bi bi-check2-all"></i> Прочитать все</button>
        </form>
    }
</div>

<div class="card-x">
    @if (Model.Count == 0)
    {
        <div class="empty">Уведомлений нет</div>
    }
    @foreach (var n in Model)
    {
        <div class="notif @(n.IsRead ? "" : "unread")">
            <div class="ico"><i class="bi @Icon(n.Text)"></i></div>
            <div class="flex-grow-1">
                <div class="text">@n.Text</div>
                <div class="small text-muted">@n.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
            </div>
            @if (!n.IsRead)
            {
                <span class="dot" title="Не прочитано"></span>
            }
        </div>
    }
</div>
