@{
    bool auth = User.Identity?.IsAuthenticated == true;
    string roleName = User.IsInRole("Admin") ? "Администратор" : User.IsInRole("Registrar") ? "Регистратор" : User.IsInRole("Doctor") ? "Врач" : "Пациент";
    string userName = User.Identity?.Name ?? "";
    string? avatarPath = User.FindFirst("AvatarPath")?.Value;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Электронная регистратура</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (auth)
    {
        <div class="app">
            <aside class="sidebar glass d-none d-lg-flex">
                <partial name="_Brand" />
                <partial name="_Nav" />
                <div class="user-card">
                    <div class="avatar sm">
                        @if (avatarPath != null) { <img src="@avatarPath" alt="" class="avatar-img" /> }
                        else { @userName.Initials() }
                    </div>
                    <div class="flex-grow-1 overflow-hidden">
                        <div class="name text-truncate">@userName</div>
                        <div class="role">@roleName</div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-quiet btn-icon btn-sm" title="Выйти" aria-label="Выйти"><i class="bi bi-box-arrow-right"></i></button>
                    </form>
                </div>
            </aside>

            <div class="offcanvas offcanvas-start glass" tabindex="-1" id="mobileNav" style="width:var(--sidebar-w)">
                <div class="offcanvas-body d-flex flex-column">
                    <partial name="_Brand" />
                    <partial name="_Nav" />
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mt-auto pt-3">
                        <button type="submit" class="btn btn-light w-100"><i class="bi bi-box-arrow-right"></i> Выйти</button>
                    </form>
                </div>
            </div>

            <div class="main">
                <div class="topbar glass d-lg-none">
                    <button class="btn btn-quiet btn-icon" aria-label="Меню" data-bs-toggle="offcanvas" data-bs-target="#mobileNav"><i class="bi bi-list"></i></button>
                    <span class="fw-medium">Регистратура</span>
                    <a class="btn btn-quiet btn-icon" aria-label="Уведомления" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell"></i></a>
                </div>
                <main class="content">
                    <partial name="_Flash" />
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <header class="guest-top">
            <div class="inner glass">
                <partial name="_Brand" />
                <div class="d-flex gap-2">
                    <a class="btn btn-quiet" asp-controller="Account" asp-action="Login">Войти</a>
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Регистрация</a>
                </div>
            </div>
        </header>
        <main class="guest-content">
            <partial name="_Flash" />
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/glass.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
