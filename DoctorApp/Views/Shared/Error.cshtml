@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="card-x empty">
    <i class="bi bi-exclamation-octagon"></i>
    <h1 class="h4 text-dark">Что-то пошло не так</h1>
    <p>Попробуйте обновить страницу или вернуться на главную.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small">Код запроса: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">На главную</a>
</div>
