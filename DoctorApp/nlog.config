<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" throwConfigExceptions="true">
  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>
  <targets>
    <target name="logfile" xsi:type="File" fileName="${basedir}/logs/doctorapp-${shortdate}.log"
            layout="${longdate} ${level:uppercase=true} ${logger:shortName=true} ${message} ${exception:format=tostring}" />
    <target name="console" xsi:type="Console" />
  </targets>
  <rules>
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="logfile,console" final="true" />
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="logfile,console" />
  </rules>
</nlog>
